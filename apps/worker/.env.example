# Stage: dev (local / personal) or testers (shared TestFlight backend).
# Alchemy also reads STAGE for stack isolation.
STAGE=dev

# Cloudflare (alchemy deploy)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Clerk — leave CLERK_SECRET_KEY empty in STAGE=dev to accept
# Authorization: Bearer test-token (userId = user_test).
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=
CLERK_JWT_AUDIENCE=yatma

# OpenRouter (agent turns; optional until M3)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Monthly token budget per user (usage cap)
USAGE_MONTHLY_TOKEN_CAP=500000
