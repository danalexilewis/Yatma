# Stage: dev (local / personal) or testers (shared TestFlight backend).
# Alchemy also reads STAGE for stack isolation.
STAGE=dev

# Cloudflare (alchemy deploy)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Clerk — leave CLERK_SECRET_KEY empty in STAGE=dev to accept
# Authorization: Bearer test-token (userId = user_test).
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=
CLERK_JWT_AUDIENCE=yatma

# OpenRouter server fallback. A personal key saved in Settings takes precedence.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Base64-encoded random 32-byte key for encrypting account API keys at rest.
# Generate with: openssl rand -base64 32
# Keep this stable; changing it makes existing saved keys unreadable.
AI_SETTINGS_ENCRYPTION_KEY=

# Exact HTTPS browser origins, comma-separated. HTTPS localhost is allowed in dev.
CORS_ALLOWED_ORIGINS=https://localhost:8081

# Daily token budget per user (UTC reset).
USAGE_DAILY_TOKEN_CAP=500000

# Optional read-only Gmail intake. Register the exact app /gmail-callback URL in Google OAuth.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://localhost:8081/gmail-callback
