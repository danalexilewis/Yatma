{
  "expo": {
    "name": "Yatma",
    "slug": "yatma",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "yatma",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yatma.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Yatma uses the microphone for voice capture and dictation.",
        "UIApplicationShortcutItems": [
          {
            "UIApplicationShortcutItemType": "com.yatma.app.dictate",
            "UIApplicationShortcutItemTitle": "Dictate",
            "UIApplicationShortcutItemSubtitle": "Capture by voice",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeCompose",
            "UIApplicationShortcutItemUserInfo": {
              "url": "yatma://capture"
            }
          },
          {
            "UIApplicationShortcutItemType": "com.yatma.app.dictate",
            "UIApplicationShortcutItemTitle": "Dictate",
            "UIApplicationShortcutItemSubtitle": "Capture by voice",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeCompose",
            "UIApplicationShortcutItemUserInfo": {
              "url": "yatma://capture"
            }
          },
          {
            "UIApplicationShortcutItemType": "com.yatma.app.dictate",
            "UIApplicationShortcutItemTitle": "Dictate",
            "UIApplicationShortcutItemSubtitle": "Capture by voice",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeCompose",
            "UIApplicationShortcutItemUserInfo": {
              "url": "yatma://capture"
            }
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F6B4A"
      },
      "package": "com.yatma.app",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F6B4A",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Yatma uses the microphone to record voice commands for transcription.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false,
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6e4f3e01-a7fe-4b07-9e4d-a37f0798600f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6e4f3e01-a7fe-4b07-9e4d-a37f0798600f"
    }
  }
}
