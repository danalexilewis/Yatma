{
  "name": "yatma-automerge-spike",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "local_protocol": "https" },
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "SPIKE_TOKEN": "local-spike-only" },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "AutomergeRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AutomergeRoom"] }],
}
